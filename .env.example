# ===== Firebase Admin SDK (จำเป็น — เอามาจาก service account .json ของคุณ) =====
# ไป Firebase Console → Project settings(⚙) → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# บรรทัดเดียว! ครอบด้วย "...", \n เป็น \\n (ดู README)
FIREBASE_PRIVATE_KEY=

# ===== App (optional แต่แนะนำ) =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Google Calendar OAuth (server only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to ${NEXT_PUBLIC_APP_URL}/api/settings/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/settings/google/callback
